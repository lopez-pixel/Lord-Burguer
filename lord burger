      },
      {
        id: 4,
        category: 'burgers',
        name: 'Lord Chicken Crispy',
        price: 27.50,
        description: 'Sobrecoxa empanada super crocante com tempero secreto, queijo muçarela, alface americana fresca e maionese verde artesanal.',
        image: 'https://images.unsplash.com/photo-1625813506062-0aeb1d7a094b?auto=format&fit=crop&w=700&q=80'
      },
      {
        id: 5,
        category: 'acompanhamentos',
        name: 'Batata Rústica Cheddar & Bacon',
        price: 19.90,
        description: 'Porção de batatas com corte rústico, sequinhas e cobertas com cheddar cremoso e farofa crocante de bacon.',
        image: 'https://images.unsplash.com/photo-1585109649139-366815a0d713?auto=format&fit=crop&w=700&q=80'
      },
      {
        id: 6,
        category: 'acompanhamentos',
        name: 'Onion Rings Empanadas',
        price: 16.00,
        description: 'Anéis de cebola selecionados e empanados com farinha especial, fritos na hora. Acompanha molho barbecue.',
        image: 'https://images.unsplash.com/photo-1639024471285-0afc3831b799?auto=format&fit=crop&w=700&q=80'
      },
      {
        id: 7,
        category: 'bebidas',
        name: 'Milk-shake de Nutella & Ninho (400ml)',
        price: 17.00,
        description: 'Sorvete de baunilha batido artesanalmente com pasta de avelã Nutella autêntica e leite Ninho polvilhado.',
        image: 'https://images.unsplash.com/photo-1572490122747-3968b75cc699?auto=format&fit=crop&w=700&q=80'
      },
      {
        id: 8,
        category: 'bebidas',
        name: 'Refrigerante Lata 350ml',
        price: 6.00,
        description: 'Coca-Cola (Original ou Zero), Guaraná Antarctica ou Fanta Laranja bem gelados.',
        image: 'https://images.unsplash.com/photo-1622483767028-3f66f32aef97?auto=format&fit=crop&w=700&q=80'
      }
    ];

    // Carrinho em memória
    let cart = [];

    // Renderizar Itens do Cardápio
    function renderProducts(category = 'todos') {
      const container = document.getElementById('products-grid');
      container.innerHTML = '';

      const filtered = category === 'todos' 
        ? products 
        : products.filter(p => p.category === category);

      filtered.forEach(p => {
        const card = document.createElement('div');
        card.className = "bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden hover:border-gray-700 transition flex flex-col group";
        card.innerHTML = `
          <div class="h-48 overflow-hidden relative">
            <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
            <span class="absolute top-3 right-3 bg-black/75 backdrop-blur-md px-2.5 py-1 rounded-lg text-amber-400 font-bold text-sm">
              R$ ${p.price.toFixed(2).replace('.', ',')}
            </span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-bold text-lg text-white group-hover:text-amber-400 transition">${p.name}</h3>
              <p class="text-xs sm:text-sm text-gray-400 mt-2 line-clamp-2">${p.description}</p>
            </div>
            <button onclick="addToCart(${p.id})" class="mt-4 w-full bg-amber-500 hover:bg-amber-400 text-black font-bold py-2.5 rounded-xl transition flex items-center justify-center gap-2 active:scale-95">
              <i class="fa-solid fa-plus text-sm"></i> Adicionar ao Pedido
            </button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // Filtrar Categoria
    function filterCategory(cat) {
      document.querySelectorAll('#category-tabs button').forEach(btn => {
        btn.className = "tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition bg-gray-900 text-gray-300 hover:bg-gray-800";
      });
      event.target.className = "tab-btn active px-4 py-2 rounded-xl text-sm font-semibold transition bg-amber-500 text-black";
      renderProducts(cat);
    }

    // Gerenciamento de Carrinho
    function addToCart(id) {
      const product = products.find(p => p.id === id);
      const existing = cart.find(item => item.id === id);

      if (existing) {
        existing.qty++;
      } else {
        cart.push({ ...product, qty: 1 });
      }

      updateCartUI();
      // Mostra drawer ao adicionar
      const drawer = document.getElementById('cart-drawer');
      if (drawer.classList.contains('hidden')) {
        toggleCart();
      }
    }

    function changeQty(id, delta) {
      const item = cart.find(i => i.id === id);
      if (!item) return;

      item.qty += delta;
      if (item.qty <= 0) {
        cart = cart.filter(i => i.id !== id);
      }
      updateCartUI();
    }

    function updateCartUI() {
      const countEl = document.getElementById('cart-count');
      const itemsContainer = document.getElementById('cart-items');
      const subtotalEl = document.getElementById('cart-subtotal');
      const totalEl = document.getElementById('cart-total');
      const deliveryEl = document.getElementById('cart-delivery');
      const orderType = document.getElementById('cust-type').value;

      const totalItems = cart.reduce((acc, item) => acc + item.qty, 0);
      countEl.innerText = totalItems;

      if (cart.length === 0) {
        itemsContainer.innerHTML = `
          <div class="text-center py-10 text-gray-500">
            <i class="fa-solid fa-burger text-4xl mb-3 text-gray-600 block"></i>
            Seu carrinho está vazio.<br>Adicione itens saborosos do cardápio!
          </div>
        `;
        subtotalEl.innerText = 'R$ 0,00';
        totalEl.innerText = 'R$ 0,00';
        return;
      }

      itemsContainer.innerHTML = '';
      let subtotal = 0;

      cart.forEach(item => {
        const itemTotal = item.price * item.qty;
        subtotal += itemTotal;

        const row = document.createElement('div');
        row.className = "flex items-center justify-between bg-gray-950 p-3 rounded-xl border border-gray-800 text-sm";
        row.innerHTML = `
          <div class="flex-1 pr-2">
            <h5 class="font-bold text-white">${item.name}</h5>
            <span class="text-xs text-amber-500">R$ ${item.price.toFixed(2).replace('.', ',')}</span>
          </div>
          <div class="flex items-center gap-2 bg-gray-900 border border-gray-700 px-2 py-1 rounded-lg">
            <button onclick="changeQty(${item.id}, -1)" class="text-gray-400 hover:text-white px-1 font-bold">-</button>
            <span class="text-white font-semibold text-xs px-1">${item.qty}</span>
            <button onclick="changeQty(${item.id}, 1)" class="text-gray-400 hover:text-white px-1 font-bold">+</button>
          </div>
        `;
        itemsContainer.appendChild(row);
      });

      const deliveryFee = orderType === 'Entrega' ? 5.00 : 0.00;
      deliveryEl.innerText = deliveryFee > 0 ? `R$ ${deliveryFee.toFixed(2).replace('.', ',')}` : 'Grátis';

      subtotalEl.innerText = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;
      totalEl.innerText = `R$ ${(subtotal + deliveryFee).toFixed(2).replace('.', ',')}`;
    }

    function toggleCart() {
      const drawer = document.getElementById('cart-drawer');
      drawer.classList.toggle('hidden');
    }

    function toggleAddressField() {
      const type = document.getElementById('cust-type').value;
      const addrBox = document.getElementById('address-box');
      if (type === 'Retirada') {
        addrBox.style.display = 'none';
      } else {
        addrBox.style.display = 'block';
      }
      updateCartUI();
    }

    // Envio do Pedido formatado para o WhatsApp da Hamburgueria
    function sendOrderToWhatsApp() {
      if (cart.length === 0) {
        alert('Seu carrinho está vazio!');
        return;
      }

      const name = document.getElementById('cust-name').value.trim();
      const type = document.getElementById('cust-type').value;
      const address = document.getElementById('cust-address').value.trim();
      const payment = document.getElementById('cust-payment').value;
      const obs = document.getElementById('cust-obs').value.trim();

      if (!name) {
        alert('Por favor, informe seu nome.');
        return;
      }

      if (type === 'Entrega' && !address) {
        alert('Por favor, informe o endereço de entrega em Ceilândia.');
        return;
      }

      let subtotal = 0;
      let orderItemsText = '';

      cart.forEach(item => {
        const itemTotal = item.price * item.qty;
        subtotal += itemTotal;
        orderItemsText += `• ${item.qty}x ${item.name} (R$ ${itemTotal.toFixed(2).replace('.', ',')})\n`;
      });

      const deliveryFee = type === 'Entrega' ? 5.00 : 0.00;
      const total = subtotal + deliveryFee;

      // Montando a mensagem para o WhatsApp do Lord Burger
      let message = `🍔 *NOVO PEDIDO - LORD BURGER CEILÂNDIA*\n`;
      message += `--------------------------------------\n`;
      message += `👤 *Cliente:* ${name}\n`;
      message += `🛵 *Tipo:* ${type}\n`;
      if (type === 'Entrega') {
        message += `📍 *Endereço:* ${address}\n`;
      }
      message += `💳 *Pagamento:* ${payment}\n`;
      if (obs) {
        message += `📝 *Observação:* ${obs}\n`;
      }
      message += `--------------------------------------\n`;
      message += `*ITENS DO PEDIDO:*\n${orderItemsText}`;
      message += `--------------------------------------\n`;
      message += `Subtotal: R$ ${subtotal.toFixed(2).replace('.', ',')}\n`;
      message += `Entrega: R$ ${deliveryFee.toFixed(2).replace('.', ',')}\n`;
      message += `*TOTAL: R$ ${total.toFixed(2).replace('.', ',')}*\n\n`;
      message += `_Aguardando confirmação do pedido!_`;

      const whatsappNumber = '5561991116257';
      const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank');
    }

    // Inicialização
    renderProducts();
  </script>
</body>
</html>
